{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://01a1ab11-6566-7f38-9592-0303c12c9eb6-8080.eur-1.aiven.app/api/:path*"
    },
    {
      "source": "/api-docs.html",
      "destination": "https://01a1ab11-6566-7f38-9592-0303c12c9eb6-8080.eur-1.aiven.app/api-docs.html"
    },
    {
      "source": "/openapi.json",
      "destination": "https://01a1ab11-6566-7f38-9592-0303c12c9eb6-8080.eur-1.aiven.app/openapi.json"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
